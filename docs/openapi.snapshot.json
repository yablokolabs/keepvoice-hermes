            "title": "Sha256"
          },
          "level_db": {
            "type": "number",
            "title": "Level Db"
          },
          "provenance": {
            "type": "string",
            "title": "Provenance"
          },
          "attribution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attribution"
          },
          "rights_confirmed_by_creator": {
            "type": "boolean",
            "title": "Rights Confirmed By Creator"
          }
        },
        "type": "object",
        "required": [
          "asset_id",
          "sha256",
          "level_db",
          "provenance",
          "rights_confirmed_by_creator"
        ],
        "title": "JobMusic"
      },
      "JobRejection": {
        "properties": {
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "rejected_at": {
            "type": "string",
            "title": "Rejected At"
          }
        },
        "type": "object",
        "required": [
          "revision",
          "reason",
          "rejected_at"
        ],
        "title": "JobRejection"
      },
      "JobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "replayed": {
            "type": "boolean",
            "title": "Replayed",
            "default": false
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          },
          "input": {
            "$ref": "#/components/schemas/JobInput"
          },
          "subtitles": {
            "$ref": "#/components/schemas/JobSubtitles"
          },
          "music": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobMusic"
              },
              {
                "type": "null"
              }
            ]
          },
          "approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobApproval"
              },
              {
                "type": "null"
              }
            ]
          },
          "rejection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobRejection"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/WarningOut"
            },
            "type": "array",
            "title": "Warnings"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "artifacts": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ArtifactLink"
            },
            "type": "object",
            "title": "Artifacts"
          },
          "retention_days": {
            "type": "integer",
            "title": "Retention Days"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "timings_ms": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Timings Ms"
          },
          "processing_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processing Ms"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "revision",
          "created_at",
          "updated_at",
          "status_url",
          "input",
          "subtitles",
          "warnings",
          "artifacts",
          "retention_days",
          "expires_at"
        ],
        "title": "JobResponse"
      },
      "JobSubtitles": {
        "properties": {
          "srt": {
            "type": "string",
            "title": "Srt"
          },
          "vtt": {
            "type": "string",
            "title": "Vtt"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "cues": {
            "items": {
              "$ref": "#/components/schemas/CueOut"
            },
            "type": "array",
            "title": "Cues"
          },
          "editable": {
            "type": "boolean",
            "title": "Editable",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "srt",
          "vtt",
          "sha256",
          "cues"
        ],
        "title": "JobSubtitles"
      },
      "MusicSelectionIn": {
        "properties": {
          "asset_id": {
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "pattern": "^[a-f0-9]{32}$",
            "title": "Asset Id"
          },
          "level_db": {
            "anyOf": [
              {
                "type": "number",
                "maximum": -6.0,
                "minimum": -40.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Level Db",
            "description": "Music gain before ducking, in dB relative to the source music level. Defaults to the service setting (-18 dB)."
          }
        },
        "type": "object",
        "required": [
          "asset_id"
        ],
        "title": "MusicSelectionIn"
      },
      "RejectIn": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 3,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "revision",
          "reason"
        ],
        "title": "RejectIn"
      },
      "ReviewIn": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision",
            "description": "Current job revision. A mismatch returns 409."
          },
          "subtitles_srt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100000
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtitles Srt",
            "description": "Complete corrected SRT. Omit to keep the current subtitles."
          },
          "music": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MusicSelectionIn"
              },
              {
                "type": "null"
              }
            ],
            "description": "Replacement music selection. Omit to keep the current selection; send null to remove music from the revision."
          }
        },
        "type": "object",
        "required": [
          "revision"
        ],
        "title": "ReviewIn",
        "example": {
          "music": {
            "asset_id": "8f14e45fceea167a5a36dedd4bea2543",
            "level_db": -18
          },
          "revision": 1,
          "subtitles_srt": "1\n00:00:04,000 --> 00:00:08,200\nYou recorded a video, but a song is playing in the background.\n"
        }
      },
      "SubmitJobIn": {
        "properties": {
          "upload_id": {
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "pattern": "^[a-f0-9]{32}$",
            "title": "Upload Id",
            "description": "Opaque ID returned by POST /v1/uploads."
          },
          "rights_confirmed": {
            "type": "boolean",
            "title": "Rights Confirmed",
            "description": "Submitter confirms authorization to process the source clip."
          },
          "source_provenance": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Source Provenance",
            "description": "Where the clip came from."
          }
        },
        "type": "object",
        "required": [
          "upload_id",
          "rights_confirmed",
          "source_provenance"
        ],
        "title": "SubmitJobIn",
        "example": {
          "rights_confirmed": true,
          "source_provenance": "Creator-owned restaurant footage",
          "upload_id": "9b3d1f0b6c2a4e5f8a7d0c1b2e3f4a5b"
        }
      },
      "UploadResponse": {
        "properties": {
          "upload_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Upload Id"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "bytes": {
            "type": "integer",
            "title": "Bytes"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "content_type": {
            "type": "string",
            "title": "Content Type"
          },
          "duration_s": {
            "type": "number",
            "title": "Duration S"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "submit_url": {
            "type": "string",
            "title": "Submit Url"
          }
        },
        "type": "object",
        "required": [
          "upload_id",
          "sha256",
          "bytes",
          "filename",
          "content_type",
          "duration_s",
          "created_at",
          "expires_at",
          "submit_url"
        ],
        "title": "UploadResponse",
        "example": {
          "bytes": 1986228,
          "content_type": "video/mp4",
          "created_at": "2026-11-02T20:10:00Z",
          "duration_s": 18.0,
          "expires_at": "2026-11-03T20:10:00Z",
          "filename": "clip.mp4",
          "height": 360,
          "sha256": "4cab1bad7c678bb3ff2b0c7c6f07414cb56f65768931f8f52f0e3b4ecff48c85",
          "submit_url": "https://keepvoice.yablokolabs.com/v1/jobs/from-upload",
          "upload_id": "9b3d1f0b6c2a4e5f8a7d0c1b2e3f4a5b",
          "width": 640
        }
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WarningOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "severity": {
            "type": "string",
            "title": "Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "title": "WarningOut"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Agent credential issued to Agento. It cannot approve a revision.",
        "scheme": "bearer"
      },
      "APIKeyHeader": {
        "type": "apiKey",
        "description": "Credential held only by the human review surface. It is required to approve an exact revision and must never be given to the planning agent.",
        "in": "header",
        "name": "X-Reviewer-Token"
      }
    }
  }
